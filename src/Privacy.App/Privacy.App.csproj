<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Privacy.App</RootNamespace>
    <Version>0.9.0</Version>
    <Product>Privacy Studio</Product>
    <Company>Studio medico</Company>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Privacy.Data\Privacy.Data.csproj" />
    <ProjectReference Include="..\Privacy.Domain\Privacy.Domain.csproj" />
  </ItemGroup>
</Project>
