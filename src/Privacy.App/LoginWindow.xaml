<Window x:Class="Privacy.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy Studio - Accesso" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24" >
        <TextBlock Text="Accesso" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
        <Label Content="_Nome utente" Target="{Binding ElementName=UserBox}" Padding="0,0,0,4"/>
        <TextBox x:Name="UserBox" TabIndex="0" AutomationProperties.Name="Nome utente"/>
        <Label Content="_Password" Target="{Binding ElementName=PasswordBox}" Padding="0,12,0,4"/>
        <PasswordBox x:Name="PasswordBox" TabIndex="1" AutomationProperties.Name="Password"/>
        <TextBlock x:Name="StatusText" Foreground="#B00020" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="20"
                   AutomationProperties.LiveSetting="Assertive"/>
        <Button x:Name="LoginButton" Content="_Accedi" IsDefault="True" TabIndex="2" Margin="0,12,0,0" Click="OnLogin"/>
    </StackPanel>
</Window>
