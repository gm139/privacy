<Window x:Class="Privacy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy Studio" Width="900" Height="560" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="NewRequestButton" Content="_Nuova richiesta…" Click="OnNewRequest" TabIndex="0" Margin="0,0,8,0"/>
                <Button x:Name="NewIncidentButton" Content="Nuovo _incidente…" Click="OnNewIncident" TabIndex="1" Margin="0,0,8,0"/>
                <Button x:Name="OpenButton" Content="A_pri selezionata" Click="OnOpen" TabIndex="2" Margin="0,0,8,0"/>
                <Button x:Name="RefreshButton" Content="_Aggiorna" Click="OnRefresh" TabIndex="3"/>
            </StackPanel>
            <TextBlock x:Name="HeaderText" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" Foreground="#B00020" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite"/>
        <TabControl x:Name="Tabs" TabIndex="4">
            <TabItem Header="Richieste in scadenza">
                <DataGrid x:Name="RequestsGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                          AutomationProperties.Name="Richieste dei diritti in scadenza" SelectionMode="Single" MouseDoubleClick="OnOpen">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Riferimento" Binding="{Binding Reference}" Width="140"/>
                        <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="180"/>
                        <DataGridTextColumn Header="Ricevuta il" Binding="{Binding Received}" Width="120"/>
                        <DataGridTextColumn Header="Scadenza" Binding="{Binding Due}" Width="120"/>
                        <DataGridTextColumn Header="Situazione" Binding="{Binding Situation}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Incidenti aperti">
                <DataGrid x:Name="IncidentsGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                          AutomationProperties.Name="Incidenti aperti" SelectionMode="Single" MouseDoubleClick="OnOpen">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Riferimento" Binding="{Binding Reference}" Width="140"/>
                        <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="160"/>
                        <DataGridTextColumn Header="Classificazione" Binding="{Binding Classification}" Width="200"/>
                        <DataGridTextColumn Header="Notifica entro (72 ore)" Binding="{Binding Deadline}" Width="180"/>
                        <DataGridTextColumn Header="Tempo residuo" Binding="{Binding Remaining}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Conservazione">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="Regole di conservazione" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <Button Content="Nuova _regola…" Click="OnNewPolicy" TabIndex="40"/>
                        <Button Content="Appro_va selezionata" Click="OnApprovePolicy" Margin="8,0,0,0" TabIndex="41"/>
                    </StackPanel>
                    <DataGrid x:Name="PoliciesGrid" Height="150" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                              AutomationProperties.Name="Regole di conservazione">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Documentazione" Binding="{Binding Class}" Width="*"/>
                            <DataGridTextColumn Header="Decorre da" Binding="{Binding Trigger}" Width="180"/>
                            <DataGridTextColumn Header="Durata" Binding="{Binding Duration}" Width="200"/>
                            <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Riesame entro" Binding="{Binding Review}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Elementi scaduti" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <Button Content="_Elimina selezionati…" Click="OnDisposeSelected" TabIndex="42"/>
                    </StackPanel>
                    <DataGrid x:Name="ExpiredGrid" Height="170" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Extended"
                              AutomationProperties.Name="Elementi scaduti">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="170"/>
                            <DataGridTextColumn Header="Riferimento" Binding="{Binding Reference}" Width="160"/>
                            <DataGridTextColumn Header="Data di riferimento" Binding="{Binding BaseDate}" Width="140"/>
                            <DataGridTextColumn Header="Scaduto il" Binding="{Binding ExpiredOn}" Width="110"/>
                            <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Regole da rivedere (illimitate o a criterio, riesame scaduto)" FontWeight="SemiBold" Margin="0,14,0,0"/>
                    <DataGrid x:Name="ReviewGrid" Height="100" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                              AutomationProperties.Name="Regole da rivedere">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Documentazione" Binding="{Binding Class}" Width="*"/>
                            <DataGridTextColumn Header="Natura" Binding="{Binding Kind}" Width="160"/>
                            <DataGridTextColumn Header="Criterio" Binding="{Binding Criterion}" Width="2*"/>
                            <DataGridTextColumn Header="Riesame era entro" Binding="{Binding Review}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Backup">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock x:Name="BackupStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button x:Name="BackupNowButton" Content="Esegui _backup ora" Click="OnBackupNow" TabIndex="50"/>
                            <Button Content="_Verifica un file…" Click="OnVerifyBackup" Margin="8,0,0,0" TabIndex="51"/>
                            <Button Content="_Esporta chiavi di recupero…" Click="OnExportKeys" Margin="8,0,0,0" TabIndex="52"/>
                            <Button Content="_Importa chiavi…" Click="OnImportKeys" Margin="8,0,0,0" TabIndex="53"/>
                        </StackPanel>
                    </StackPanel>
                    <DataGrid x:Name="BackupGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" AutomationProperties.Name="Esecuzioni di backup">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Avvio" Binding="{Binding Started}" Width="160"/>
                            <DataGridTextColumn Header="Esito" Binding="{Binding Status}" Width="110"/>
                            <DataGridTextColumn Header="Verificato" Binding="{Binding Verified}" Width="160"/>
                            <DataGridTextColumn Header="File" Binding="{Binding File}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Registro">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Nuova _attività…" Click="OnNewActivity" TabIndex="30"/>
                        <Button Content="_Apri o modifica…" Click="OnOpenActivity" Margin="8,0,0,0" TabIndex="31"/>
                        <Button Content="Nuova _revisione…" Click="OnNewRevision" Margin="8,0,0,0" TabIndex="32"/>
                        <Button Content="_Esporta alla data…" Click="OnExportRegistry" Margin="8,0,0,0" TabIndex="33"/>
                    </StackPanel>
                    <DataGrid x:Name="ActivitiesGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                              AutomationProperties.Name="Attività di trattamento" MouseDoubleClick="OnOpenActivity">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Codice" Binding="{Binding Code}" Width="90"/>
                            <DataGridTextColumn Header="Attività" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Revisione" Binding="{Binding Version}" Width="90"/>
                            <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="130"/>
                            <DataGridTextColumn Header="In vigore dal" Binding="{Binding From}" Width="110"/>
                            <DataGridTextColumn Header="Riesame entro" Binding="{Binding Review}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Pazienti">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Label Content="_Cerca" Target="{Binding ElementName=SearchBox}" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Width="220" TabIndex="10" TextChanged="OnSearchChanged" AutomationProperties.Name="Cerca interessato"/>
                        <Button Content="Nuo_vo interessato…" Click="OnNewSubject" Margin="12,0,0,0" TabIndex="11"/>
                        <Button Content="_Rettifica…" Click="OnRectifySubject" Margin="8,0,0,0" TabIndex="12"/>
                        <Button Content="Consegna _informativa…" Click="OnDeliver" Margin="8,0,0,0" TabIndex="13"/>
                        <Button Content="Cons_egne…" Click="OnHistory" Margin="8,0,0,0" TabIndex="14"/>
                        <Button Content="Ri_muovi…" Click="OnRemoveSubject" Margin="8,0,0,0" TabIndex="15"/>
                    </StackPanel>
                    <DataGrid x:Name="SubjectsGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" SelectionMode="Single"
                              AutomationProperties.Name="Interessati" MouseDoubleClick="OnHistory">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Codice" Binding="{Binding Code}" Width="110"/>
                            <DataGridTextColumn Header="Cognome" Binding="{Binding Last}" Width="200"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding First}" Width="200"/>
                            <DataGridTextColumn Header="Nato il" Binding="{Binding Birth}" Width="110"/>
                            <DataGridTextColumn Header="Stato" Binding="{Binding Status}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <TabItem Header="Informative">
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Nuova _informativa…" Click="OnNewNotice" TabIndex="20"/>
                    </StackPanel>
                    <DataGrid x:Name="NoticesGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column"
                              AutomationProperties.Name="Informative pubblicate">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Versione" Binding="{Binding Version}" Width="100"/>
                            <DataGridTextColumn Header="In vigore dal" Binding="{Binding From}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
