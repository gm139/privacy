<Application x:Class="Privacy.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/></Style>
        <Style TargetType="TextBox"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="4"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="4"/></Style>
        <Style TargetType="Button"><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,6"/></Style>
    </Application.Resources>
</Application>
